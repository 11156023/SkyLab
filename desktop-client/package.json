{
  "name": "SkyLab-connect",
  "version": "0.2.0-beta.12",
  "main": "dist-electron/main/index.js",
  "description": "SkyLab Connect desktop client",
  "private": true,
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">= 22.12.0"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "test:update": "node scripts/test-update.mjs",
    "test:settings": "node scripts/test-settings.mjs",
    "test:backend-url": "node scripts/test-backend-url.mjs",
    "test:auth": "node scripts/test-auth-login-url.mjs",
    "test:tunnel": "node scripts/test-tunnel.mjs",
    "test:resources": "node scripts/test-resource-access.mjs",
    "test:resource-groups": "node scripts/test-resource-groups.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "npm run build && electron-builder -p never",
    "prepare:wireguard:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-wireguard.ps1",
    "build:electron:win": "npm run prepare:wireguard:win && npm run build && electron-builder --win -p never",
    "build:electron:win:unsigned": "npm run prepare:wireguard:win && npm run build && electron-builder --win -p never --config.forceCodeSigning=false --config.win.signExecutable=false",
    "preview": "vite preview",
    "lint": "eslint src/ electron/ --ext .ts,.tsx,.vue",
    "lint:fix": "eslint src/ electron/ --ext .ts,.tsx,.vue --fix",
    "audit:security": "node scripts/audit-security.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@material-design-icons/font": "^0.14.15",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.1",
    "prettier": "^3.6.2",
    "sass": "^1.93.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.1.2",
    "vue-tsc": "^3.1.2"
  },
  "overrides": {
    "minimatch": ">=10.2.3",
    "@electron/asar": {
      "minimatch": "^3.1.2"
    },
    "underscore": ">=1.13.8"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "electron-log": "^5.4.3",
    "element-plus": "^2.11.7",
    "pinia": "^4.0.3",
    "tree-kill": "^1.2.2",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.2",
    "vue-router": "^5.3.1"
  }
}
