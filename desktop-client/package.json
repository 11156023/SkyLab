{
  "name": "SkyLab-connect",
  "version": "0.2.0-beta.5",
  "license": "AGPL-3.0-only",
  "main": "dist-electron/main/index.js",
  "description": "SkyLab Connect desktop client",
  "private": true,
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">= 22.12.0"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:3344/"
    }
  },
  "scripts": {
    "test:auth": "node scripts/test-auth.mjs",
    "test:tunnel": "node scripts/test-tunnel.mjs",
    "test:resources": "node scripts/test-resource-access.mjs",
    "test:settings": "node scripts/test-settings.mjs",
    "test:polling": "node scripts/test-session-polling.mjs",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:electron": "npm run build && electron-builder -p never",
    "prepare:wireguard:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-wireguard.ps1",
    "build:electron:win": "npm run prepare:wireguard:win && npm run build && electron-builder --win -p never",
    "build:electron:win:unsigned": "npm run prepare:wireguard:win && npm run build && electron-builder --win -p never --config.forceCodeSigning=false --config.win.signExecutable=false",
    "preview": "vite preview",
    "lint": "eslint src/ electron/ --ext .ts,.tsx,.vue",
    "lint:fix": "eslint src/ electron/ --ext .ts,.tsx,.vue --fix",
    "audit:security": "node scripts/audit-security.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-icons/material-symbols": "^2.0.6",
    "@iconify/vue": "^5.0.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.6.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "postcss": "^8.5.31",
    "postcss-import": "^17.0.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-electron": "^1.1.2",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "minimatch": ">=10.2.3",
    "@electron/asar": {
      "minimatch": "^3.1.2"
    },
    "underscore": ">=1.13.8"
  },
  "dependencies": {
    "@seald-io/nedb": "^4.1.2",
    "@vueuse/core": "^15.0.0",
    "animate.css": "^4.1.1",
    "electron-log": "^5.4.4",
    "element-plus": "^2.14.7",
    "pinia": "^4.1.0",
    "tree-kill": "^1.2.2",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  }
}
