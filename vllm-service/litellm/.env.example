# LiteLLM is included by the root Compose, or can run standalone. Copy to .env in this
# directory; never add these values to the root Campus .env or commit them.
#
# `bash scripts/prepare-ai-stack.sh --init-env` fills every replace-with-* value
# below except VLLM_UPSTREAM_API_KEY (copied from .env.API when it exists) and
# never overwrites a value that is already set.
LITELLM_MASTER_KEY=replace-with-a-production-master-key
# Bearer key LiteLLM sends to each vLLM /v1 endpoint. For local engines set this
# to the same secret as API_KEY in .env.API; for a remote host (e.g. DGX) use
# that host's vLLM API_KEY.
VLLM_UPSTREAM_API_KEY=replace-with-the-vllm-api-key-from-.env.API

# LiteLLM virtual keys, usage records and schema migrations use this permanent
# service database. It must use a dedicated database and role; the Campus
# application database is not a valid target. LiteLLM sits on the Compose
# network and connects to PostgreSQL directly as db:5432 (never pgbouncer).
# prepare-ai-stack.sh --start creates this role/database when the host is db.
# An external PostgreSQL may be named by IP/hostname instead.
DATABASE_URL=postgresql://litellm:replace-with-db-password@db:5432/litellm
LITELLM_SALT_KEY=replace-with-an-immutable-random-salt-key

# Optional: host-side port (bound to 127.0.0.1) for health checks and admin tools.
# LITELLM_HOST_PORT=4000
# Optional: pin the exact image tag/digest tested in your deployment.
# LITELLM_IMAGE=litellm/litellm:<tested-tag>
# Remote models reference a key name in models.json; only LiteLLM receives it.
# REMOTE_LAB_API_KEY=replace-with-the-remote-vllm-api-key
