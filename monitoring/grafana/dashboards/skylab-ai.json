    {
      "id": 7,
      "type": "stat",
      "title": "平台錯誤率",
      "description": "連不到上游、上游 5xx、串流中斷等（不含呼叫端 4xx 與限流），近 5 分鐘",
      "datasource": {
        "type": "prometheus",
        "uid": "skylab-prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "skylab-prometheus"
          },
          "expr": "(sum(rate(skylab_ai_requests_total{outcome=~\"unavailable|upstream_error|stream_error|error\"}[5m])) or vector(0)) / clamp_min((sum(rate(skylab_ai_requests_total[5m])) or vector(0)), 1e-9)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
