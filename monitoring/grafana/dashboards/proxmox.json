{
  "uid": "skylab-proxmox",
  "title": "Proxmox VE（Metric Server）",
  "tags": [
    "skylab",
    "proxmox"
  ],
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "節點",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "skylab-influxdb"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"host\", predicate: (r) => r._measurement == \"cpustat\" and r.object == \"nodes\", start: -1d)",
        "definition": "PVE nodes",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "gateway_vm",
        "label": "Gateway VM",
        "description": "Gateway 主機在 PVE 上的 VM／LXC 名稱；名稱含 gateway 的會排在最前面並預設選取",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "skylab-influxdb"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "query": "import \"influxdata/influxdb/schema\"\nimport \"strings\"\nschema.tagValues(bucket: v.defaultBucket, tag: \"host\", predicate: (r) => r._measurement == \"system\" and (r.object == \"qemu\" or r.object == \"lxc\"), start: -1d)\n  |> map(fn: (r) => ({_value: r._value, priority: if strings.containsStr(v: strings.toLower(v: r._value), substr: \"gateway\") then 0 else 1}))\n  |> sort(columns: [\"priority\", \"_value\"])\n  |> keep(columns: [\"_value\"])",
        "definition": "PVE guests (gateway first)",
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Gateway 主機（exporter）",
      "type": "link",
      "url": "/grafana/d/skylab-gateway",
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
