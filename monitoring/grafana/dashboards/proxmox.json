          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"system\" and r.object == \"storages\" and (r._field == \"used\" or r._field == \"total\"))\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> filter(fn: (r) => r.total > 0.0)\n  |> map(fn: (r) => ({storage: r.host, node: r.nodename, used: r.used, total: r.total, usage: r.used / r.total * 100.0}))\n  |> group()\n  |> sort(columns: [\"usage\"], desc: true)"
