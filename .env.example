# =============================================================================
# SkyLab Campus 部署設定（LiteLLM 另使用 vllm-service/litellm/.env）
#
#   cp .env.example .env
#   # 改好下面【1】【2】兩區，其餘多半保持預設即可
#   docker compose up -d --build
#
# 變數名已對齊後端實際讀取的設定（core/config.py、features/ai、ai/*）。
# 註解掉或留空的項目代表「有合理預設、通常不用設」。
# =============================================================================

# -----------------------------------------------------------------------------
# 【1】必改 —— 身分與密鑰（正式對外務必修改）
# -----------------------------------------------------------------------------
# 產生：python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis
# 第一位管理員帳號（登入後在「管理員介面」設定 Proxmox 連線，連線資訊存資料庫）
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis
# 資料庫密碼（容器內 PostgreSQL 會用這個值建立）
POSTGRES_PASSWORD=changethis

# -----------------------------------------------------------------------------
# 【2】環境
# -----------------------------------------------------------------------------
# local / staging / production。
# 設 production 時，上面三個密鑰若仍是 "changethis" 會直接啟動失敗（安全檢查）。
ENVIRONMENT=local
ENABLE_SIGNUP=true
PROJECT_NAME=SkyLab
# 後端寄信時產生的前端連結位址（沒用到 email 可不管；nginx 同源下前端會自動跟著訪問網址走）
FRONTEND_HOST=http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# 【3】資料庫（容器內 PostgreSQL，通常保持預設）
# -----------------------------------------------------------------------------
# 容器內固定連服務名 db（docker-compose 會強制覆蓋為 db），請勿改成外部 IP
# Compose 會把 backend/worker 的 POSTGRES_SERVER 覆寫成 pgbouncer（prestart 直連
# db）；這個值只影響在容器外直接跑 fastapi dev 的情況。
POSTGRES_SERVER=db
POSTGRES_PORT=5432
# Host-only Compose mapping for the local db container; containers still use
# db:5432.  Use a different value if 5433 is already occupied.
POSTGRES_HOST_PORT=5433
# Host port for the nginx entrypoint (frontend + /api + /ws).  Defaults to
# 8082 because rootless Docker cannot bind privileged ports (< 1024).
NGINX_HOST_PORT=8082
POSTGRES_DB=app
POSTGRES_USER=postgres

# -----------------------------------------------------------------------------
# 【4】Compose 內部用（保持預設即可）
# -----------------------------------------------------------------------------
# 後端不讀 DOMAIN / STACK_NAME，目前僅 docker-compose 殘留的標籤需要
DOMAIN=localhost
STACK_NAME=SkyLab
# 本地 build 的映像名稱
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend



# -----------------------------------------------------------------------------
# 【5】Redis（速率限制 / JTI 撤銷 / arq 任務佇列 / 監控快取）
# -----------------------------------------------------------------------------
# 容器部署建議 true；容器內 URL 用服務名 redis
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# 【6】CORS（nginx 同源時可留空；前後端不同網域才需要列來源）
# -----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS=

# -----------------------------------------------------------------------------
# 【7】Proxmox 連線（選填）
#   實際連線在「管理員介面」設定並加密存進資料庫，這裡通常不用填。
#   下列為後端啟動時的 fallback 預設，需要時再取消註解。
# -----------------------------------------------------------------------------
# PROXMOX_HOST=
# PROXMOX_USER=
# PROXMOX_PASSWORD=
# PROXMOX_VERIFY_SSL=false

# -----------------------------------------------------------------------------
# 【8】System AI / vLLM（選填；不用 AI 功能保持預設即可）
#   只有這三個從 env 讀；temperature / max_tokens 等細節在 backend/config/system-ai.json
# -----------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=vllm-secret-key-change-me
VLLM_MODEL_NAME=gemma4-26b-a4b-it

# -----------------------------------------------------------------------------
# 【9】AI API LiteLLM 代理（選填）
# LiteLLM 為對外 AI API 的主要 gateway；填入受限的 LiteLLM service key。
# 下列位址供 Compose backend 使用；主機程序執行 backend 時改用
# http://127.0.0.1:4000，跨主機部署則使用受限的 private/TLS endpoint。
# -----------------------------------------------------------------------------
AI_API_BASE_URL=http://host.docker.internal:4000
AI_API_API_KEY=ai-api-secret-key-change-me
AI_API_TIMEOUT=120
AI_API_MAX_REQUEST_BODY_BYTES=1048576
AI_API_RATE_LIMIT_PER_MINUTE=20
AI_API_RATE_LIMIT_WINDOW_SECONDS=60
# 使用者看見的 Campus 對外根網址，不是 LiteLLM 位址；正式部署請填實際網域。
AI_API_PUBLIC_BASE_URL=http://localhost:8082

# 主 Compose include vllm-service/litellm/docker-compose.yml；它的 master
# key、upstream key、DATABASE_URL、salt key 請只放在該目錄的 .env。此處僅
# 保留 Campus backend 連線使用的受限 service identity，絕不可填 master key。
LITELLM_RUNTIME_BASE_URL=http://host.docker.internal:4000
# 主機程序執行 backend 時同樣改用 http://127.0.0.1:4000。
# 與 AI_API_API_KEY 使用同一把受限 LiteLLM service key。
# LITELLM_RUNTIME_API_KEY=
# LITELLM_SERVICE_API_KEY=  # 同一把受限 service key；prepare script 可由 AI_API_API_KEY 取得

# 若主機埠被其他服務占用，可調整；容器內連線埠不變。
BACKEND_HOST_PORT=8000
REDIS_HOST_PORT=6379

# LiteLLM 正式服務資料庫初始化／驗證參數（選填；供 scripts/init-litellm-db.sh 使用）。
# 資料庫保存虛擬金鑰與用量紀錄，須使用獨立資料庫與帳號。
# 這些參數不會自動產生 DATABASE_URL；實際連線請設定於 vllm-service/litellm/.env，
# 且不可指向 Campus 應用程式資料庫。
# LITELLM_DB_NAME=litellm
# LITELLM_DB_USER=litellm
# LITELLM_DB_PASSWORD=

# -----------------------------------------------------------------------------
# 【10】SSH 遠端執行 / PVE log collector（選填）
# -----------------------------------------------------------------------------
# SSH host key 不再有開關：連線一律用自管的 known_hosts（首次連線 TOFU 記錄，
# 之後對不上就拒絕），所以沒有 SSH_INSECURE_HOST_KEY 這個設定。
SSH_DEFAULT_USER=root
SSH_TIMEOUT=30

# -----------------------------------------------------------------------------
# 【11】Email / SMTP（選填；不設則停用寄信）
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=

# -----------------------------------------------------------------------------
# 【12】其他選填
# -----------------------------------------------------------------------------
# Google OAuth 登入
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sentry 錯誤追蹤（後端＋worker）；SENTRY_RELEASE 例如填 git commit，方便看哪一版開始出錯
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=
# 前端（瀏覽器）Sentry：建置 frontend 映像時帶入；建議在 Sentry 開一個獨立的 Browser 專案
VITE_SENTRY_DSN=
# Desktop client / WireGuard tunnel
# DESKTOP_CLIENT_BACKEND_URL=http://localhost:8000
DESKTOP_CLIENT_DOWNLOAD_URL=https://github.com/1Ray0/SkyLab-Connect-Releases/releases/latest/download/SkyLab-Connect-Setup.exe
# WIREGUARD_ENDPOINT_HOST=
# WIREGUARD_ENDPOINT_PORT=51821
# WIREGUARD_INTERFACE=wg0
# WIREGUARD_CLIENT_SUBNET=10.250.0.0/16
# WIREGUARD_VM_SUBNET=10.10.0.0/16
# WIREGUARD_KEEPALIVE_SECONDS=25
# WIREGUARD_SESSION_TTL_SECONDS=28800
# WIREGUARD_RECONCILE_ENABLED=true
# WIREGUARD_RECONCILE_INTERVAL_SECONDS=60
# WIREGUARD_REVOKED_RETENTION_DAYS=30
# WIREGUARD_ALLOW_INACTIVE_PEER_TRANSFER=false
# Logging（容器建議 LOG_JSON=true；監控 stack 的 Loki 靠 JSON 解析 level／request_id）
LOG_LEVEL=INFO
LOG_JSON=true
LOG_FILE_ENABLED=true
# docker logs 輪替（每個容器最多 MAX_SIZE × MAX_FILE）
# DOCKER_LOG_MAX_SIZE=10m
# DOCKER_LOG_MAX_FILE=5

# -----------------------------------------------------------------------------
# 【13】監控 stack（選用）：docker compose --profile monitoring up -d
# 說明見 docs/monitoring.md
# -----------------------------------------------------------------------------
# 設了這行之後，一般的 docker compose up -d（含 CI 部署 workflow）就會一起啟動監控 stack
# COMPOSE_PROFILES=monitoring
# rootless Docker（docker info 的 SecurityOptions 有 name=rootless）要改成使用者自己的路徑，
# 否則 Alloy 收不到日誌、cAdvisor 抓不到容器；<uid> 用 id -u 查，data-root 看 docker info 的 Docker Root Dir
# DOCKER_SOCKET=/run/user/<uid>/docker.sock
# CONTAINERD_SOCKET=/run/user/<uid>/docker/containerd/containerd.sock
# DOCKER_DATA_ROOT=/home/<user>/.local/share/docker
# /metrics 的 Bearer token（留空＝不驗證；/metrics 本來就只在內網，nginx 不轉發）
# 設了之後也要寫進 monitoring/prometheus/metrics_token 並打開 prometheus.yml 的 authorization
# METRICS_TOKEN=
# Grafana：經 nginx 的 /grafana/ 進入；GRAFANA_ROOT_URL 填對外網址（例如 https://skylab.example.edu/grafana/）
GRAFANA_ADMIN_PASSWORD=changethis
# GRAFANA_ROOT_URL=
# SkyLab 管理員免密碼進 Grafana（nginx auth_request + Grafana auth.proxy，見 docs/monitoring.md）
# GRAFANA_AUTH_PROXY_ENABLED=true
# GRAFANA_SESSION_EXPIRE_MINUTES=480
# nginx 與 Grafana 專用網段；和主機或其他 docker 網路衝突時三個一起改（nginx IP 要在網段內、ip_range 外）
# GRAFANA_AUTHPROXY_SUBNET=172.30.253.0/28
# GRAFANA_AUTHPROXY_IP_RANGE=172.30.253.8/29
# GRAFANA_AUTHPROXY_NGINX_IP=172.30.253.2
# InfluxDB 2：接收 Proxmox VE 內建 Metric Server 推送的節點／VM 指標
# PVE 節點要連得到，所以通常要把 INFLUXDB_BIND_ADDRESS 改成 SkyLab 主機的內網 IP（或 0.0.0.0）
INFLUXDB_ADMIN_PASSWORD=changethis-influxdb
INFLUXDB_ADMIN_TOKEN=changethis-influxdb-token
# INFLUXDB_ORG=skylab
# INFLUXDB_BUCKET=proxmox
# INFLUXDB_RETENTION=30d
# INFLUXDB_BIND_ADDRESS=127.0.0.1
