# 留空 = same-origin，/api 與 /ws 由 vite dev server 代轉到後端
# （見 vite.config.js 的 proxy 設定）。填絕對網址會繞過 proxy，
# 屆時該網址的 origin 必須列進後端 BACKEND_CORS_ORIGINS。
VITE_API_URL=
# Optional direct download override; otherwise use the backend download endpoint.
VITE_DESKTOP_CLIENT_DOWNLOAD_URL=
VITE_GOOGLE_CLIENT_ID=
